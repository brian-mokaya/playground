{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESP32 Telemetry Schema",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["status", "sensor", "error", "log"],
      "description": "Telemetry message type"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds"
    },
    "state": {
      "type": "string",
      "enum": ["idle", "running", "error", "charging"],
      "description": "Device state"
    },
    "battery": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Battery percentage"
    },
    "temperature": {
      "type": "number",
      "description": "Chip temperature in Celsius"
    },
    "uptime": {
      "type": "integer",
      "minimum": 0,
      "description": "Device uptime in seconds"
    },
    "proximity": {
      "type": "integer",
      "description": "Proximity sensor reading (0-1023)"
    },
    "light": {
      "type": "integer",
      "description": "Light sensor reading (0-1023)"
    },
    "motion": {
      "type": "boolean",
      "description": "Motion detected"
    },
    "error_code": {
      "type": "integer",
      "description": "Error code if type is error"
    },
    "message": {
      "type": "string",
      "description": "Human-readable message"
    }
  }
}
