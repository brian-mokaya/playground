{
  "testEnvironment": "node",
  "testMatch": ["**/*.test.js"],
  "collectCoverageFrom": [
    "voice/**/*.js",
    "logic/**/*.js",
    "iot/**/*.js",
    "!**/*.test.js"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 50,
      "functions": 50,
      "lines": 50,
      "statements": 50
    }
  },
  "transform": {}
}
