{
  "name": "inclusive-voice-controlled-ide",
  "version": "0.1.0",
  "description": "Accessible, offline-first, voice-controlled IDE for ESP32 microcontroller programming",
  "main": "main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9222",
    "build": "electron-builder",
    "lint": "eslint . --ext .js",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules npx jest --watch"
  },
  "author": "Inclusive Voice IDE Team",
  "license": "MIT",
  "dependencies": {
    "blockly": "^11.0.0",
    "mqtt": "^4.3.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  }
}
